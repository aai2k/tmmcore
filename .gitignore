# Benchmark virtualenv, ~1.3 GB of torch/jax. Recreate with the pip lines in
# benchmarks/README.md
.venv/

__pycache__/
*.pyc

# Local working notes
notes/

# MkDocs build output
site/

# Docs preview virtualenv
.venv-docs/

# Generated benchmark tables; published numbers live in docs/comparison.md
benchmarks/tables.md

# WebAssembly build output, checked before it replaces src/wasm/tmm_kernel.wasm
build/

# Python package build output: the kernel library (.so on macOS too), the
# license copy setup.py makes, the reference values python/tests/reference.mjs
# writes, and the wheel folders of a local build and of cibuildwheel. The
# compiler's own build folder is matched by build/ above.
python/tmmcore/_tmmcore.dll
python/tmmcore/_tmmcore.so
python/LICENSE
python/tests/reference.json
*.egg-info/
dist/
wheelhouse/
